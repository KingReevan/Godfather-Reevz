<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower. allowBackup="false" already turns backup off there; these rules exclude
    everything as well, so the app stays backup-free even if that flag is ever flipped.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
